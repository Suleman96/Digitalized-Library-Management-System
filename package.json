{
  "name": "iqra-digital-library",
  "version": "3.0.0",
  "private": true,
  "description": "Hybrid-retrieval digital library \u2014 Python API + TypeScript frontend.",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "python -u -m uvicorn apps.api.main:app --reload --reload-dir apps/api --port 8000",
    "dev:web": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "start": "concurrently -n api,web -c blue,green \"npm:start:api\" \"npm:start:web\"",
    "start:api": "python -u -m uvicorn apps.api.main:app --port 8000",
    "start:web": "npm run start --workspace apps/web",
    "lint": "npm run lint --workspace apps/web",
    "typecheck": "npm run typecheck --workspace apps/web",
    "test": "pytest tests/ -q",
    "gen:types": "npm run gen:types --workspace apps/web",
    "setup": "pip install -r requirements.txt && npm install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
