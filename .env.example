# ── Iqra Digital Library v2 — Environment Variables ───────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git — it contains secrets.

# ── Google Books API ──────────────────────────────────────────────────────────
# Get a free key at: https://console.cloud.google.com/apis/library/books.googleapis.com
GOOGLE_API_KEY=YOUR_GOOGLE_BOOKS_API_KEY_HERE

# ── AI Provider API Keys (add the ones you want to use) ──────────────────────

# Claude (Anthropic) — recommended
# Get key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE

# OpenAI — optional
# OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE

# Google Gemini — optional
# GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ── Ollama (local, free, no API key needed) ───────────────────────────────────
# Run: ollama serve  (then: ollama pull llama3.2)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# ── Server settings ───────────────────────────────────────────────────────────
# Defaults to 0.0.0.0:7860 if not set
# SERVER_HOST=0.0.0.0
# SERVER_PORT=7860

# Set to "true" to enable Gradio's public share tunnel
# GRADIO_SHARE=false
