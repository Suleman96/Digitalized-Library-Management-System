# ── Iqra Digital Library v2 — Environment Variables ───────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git — it contains secrets.

# ── Google Books API ──────────────────────────────────────────────────────────
# Get a free key at: https://console.cloud.google.com/apis/library/books.googleapis.com
GOOGLE_API_KEY=YOUR_GOOGLE_BOOKS_API_KEY_HERE

# ── AI Provider API Keys (add the ones you want to use) ──────────────────────

# Claude (Anthropic) — recommended
# Get key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE

# OpenAI — optional
# OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE

# Google Gemini — optional
# GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Groq — optional, free tier, very fast inference
# Get key at: https://console.groq.com/
# GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE

# ── Ollama (local, free, no API key needed) ───────────────────────────────────
# Run: ollama serve  (then: ollama pull llama3.2)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# ── API server (v3) ───────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the API.
# Defaults to http://localhost:3000,http://127.0.0.1:3000
# ALLOWED_ORIGINS=http://localhost:3000,https://iqra-library.vercel.app

# Per-IP cap on AI-touching routes (/api/agent, /api/explain, /api/llm/connect).
# The deployment's own keys are spent here, so keep this low on public hosts.
# RATE_LIMIT_PER_MINUTE=20

# Override the repository root. Set this in Docker; unnecessary locally.
# IQRA_ROOT=/app

# ── Auto-connect an LLM at boot (optional) ────────────────────────────────────
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile
